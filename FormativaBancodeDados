create database academiaMovimentoMais_y;

use academiaMovimentoMais_y;

select db_name() as BancoAtual;

create table Clientes(
    IdCliente int primary key identity(1,1),
    Nome varchar(100) not null,
    CPF char(11) not null unique,
    Email varchar(100) not null unique,
    Telefone varchar(20) not null,
    DataNascimento date,
    Ativo bit not null default 1
);

create table Instrutores(
    IdInstrutor int primary key identity(1,1),
    Nome varchar(100) not null,
    CREF varchar(20) not null unique,
    Especialidade varchar(80) not null,
    Email varchar(100) not null unique,
    Ativo bit default 1
);

create table Modalidades(
    IdModalidade int primary key identity(1,1),
    NomeModalidade varchar(80) not null unique,
    Nivel varchar(20) not null,
    DuracaoMinutos int not null check (DuracaoMinutos > 0),
    Descricao varchar(200)
);

create table Planos(
    IdPlano int primary key identity(1,1),
    NomePlano varchar(80) not null unique,
    ValorMensal decimal(10,2) not null check (ValorMensal > 0),
    DuracaoMeses int not null check (DuracaoMeses > 0 and DuracaoMeses <= 24),
    AcessoLivre bit default 1
);

create table Matriculas(
    IdMatricula int primary key identity(1,1),
    IdCliente int not null,
    IdPlano int not null,
    DataInicio date not null,
    StatusMatricula varchar(15) not null default 1,
    Desconto decimal(5,2) default 0 check (Desconto >= 0 and Desconto <= 100),

    constraint UQ_Matriculas_ClientesPlano unique (IdCliente, IdPlano),
    constraint FK_Matriculas_Clientes
        foreign key (IdCliente) references Clientes(IdCliente),
    constraint FK_Matriculas_Planos
        foreign key (IdPlano) references Planos(IdPlano)
);

create table Aulas(
    IdAula int primary key identity(1,1),
    IdModalidade int not null,
    IdInstrutor int not null,
    DataAula date not null,
    Horario time not null,
    Vagas int not null check (Vagas >= 0 and Vagas <= 50),
    Sala varchar(30) not null,

    constraint FK_Aulas_Modalidades
        foreign key (IdModalidade) references Modalidades(IdModalidade),
    constraint FK_Aulas_Instrutores
        foreign key (IdInstrutor) references Instrutores(IdInstrutor)
);

